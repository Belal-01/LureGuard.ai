      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT coalesce(severity, 'unset') AS metric, count(*) AS value FROM findings WHERE ts >= NOW() - INTERVAL '7 days' AND (NULLIF('${investigation_id}', '') IS NULL OR investigation_id::text = NULLIF('${investigation_id}', '')) GROUP BY severity",
