          "format": "table",
          "rawSql": "SELECT coalesce(verdict, 'open') AS metric, count(*) AS value FROM investigations WHERE $__timeFilter(started_at) AND (NULLIF('${investigation_id}', '') IS NULL OR id::text = NULLIF('${investigation_id}', '')) GROUP BY verdict",
          "refId": "A"
        }
      ],
      "title": "Investigation verdicts",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "lureguard-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
