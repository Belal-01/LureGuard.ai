  "panels": [
    {
      "datasource": {
        "type": "postgres",
        "uid": "lureguard-pg"
      },
      "description": "Point-in-time: how many investigations are open right now. Not a trend — `investigations` records state, not a per-hour history.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT count(*) AS open FROM investigations WHERE status = 'open' AND (NULLIF('${investigation_id}', '') IS NULL OR id::text = NULLIF('${investigation_id}', ''))",
          "refId": "A"
        }
      ],
      "title": "Open investigations",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "lureguard-pg"
      },
      "description": "A spike can mean a runaway/looping agent — more is worse past a point",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT $__timeGroup(ts, '$__interval') AS time, count(*) AS actions FROM agent_actions WHERE $__timeFilter(ts) AND (NULLIF('${investigation_id}', '') IS NULL OR investigation_id::text = NULLIF('${investigation_id}', '')) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Agent tool calls (24h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "lureguard-pg"
      },
      "description": "Inverted: fewer reports than closed work implies stalled documentation, so fewer is worse",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT $__timeGroup(created_at, '$__interval') AS time, count(*) AS reports FROM reports WHERE $__timeFilter(created_at) AND (NULLIF('${investigation_id}', '') IS NULL OR investigation_id::text = NULLIF('${investigation_id}', '')) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Reports (7d)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "lureguard-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
