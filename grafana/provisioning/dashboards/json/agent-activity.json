      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT coalesce(mitre_technique, 'none') AS metric, count(*) AS value FROM findings WHERE mitre_technique IS NOT NULL AND ts >= NOW() - INTERVAL '7 days' AND (NULLIF('${investigation_id}', '') IS NULL OR investigation_id::text = NULLIF('${investigation_id}', '')) GROUP BY mitre_technique ORDER BY value DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Top MITRE techniques (7d)",
