      "id": 5,
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), count(*) AS value FROM agent_actions WHERE $__timeFilter(ts) AND (NULLIF('${investigation_id}', '') IS NULL OR investigation_id::text = NULLIF('${investigation_id}', '')) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Tool calls over time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "lureguard-pg"
      },
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Investigation Console",
              "url": "/d/lureguard-investigation/lureguard-investigation-console?var-investigation_id=${__data.fields.investigation_id}&${__url_time_range}"
            }
          ]
        }
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 6,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT i.id AS investigation_id, i.started_at, i.subject, i.status, i.verdict, i.severity, count(a.id) AS tool_calls FROM investigations i LEFT JOIN agent_actions a ON a.investigation_id = i.id WHERE $__timeFilter(i.started_at) AND (NULLIF('${investigation_id}', '') IS NULL OR i.id::text = NULLIF('${investigation_id}', '')) GROUP BY i.id ORDER BY i.started_at DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Recent investigations",
      "type": "table"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "lureguard-pg"
