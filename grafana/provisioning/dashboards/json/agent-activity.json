        "y": 60
      },
      "id": 12,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT e.ts, host(e.src_ip) AS src_ip, e.geo_country, e.channel, e.wazuh_rule_level, e.wazuh_rule_description, d.p AS ml_score, d.decision FROM events e LEFT JOIN decisions d ON d.event_id = e.id WHERE $__timeFilter(e.ts) AND (NULLIF('${src_ip}', '') IS NULL OR host(e.src_ip) = NULLIF('${src_ip}', '')) AND (NULLIF('${agent_id}', '') IS NULL OR '${agent_id}' = 'All' OR e.agent_id = '${agent_id}') AND (NULLIF('${channel}', '') IS NULL OR '${channel}' = 'All' OR e.channel = '${channel}') AND (NULLIF('${severity}', '') IS NULL OR e.wazuh_rule_level >= NULLIF('${severity}', '')::int) ORDER BY e.ts DESC LIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Attack timeline (events + ML score)",
      "type": "table"
    },
