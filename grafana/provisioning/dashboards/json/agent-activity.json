      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT f.investigation_id, f.ts, f.evidence_id, f.finding, f.mitre_technique, f.severity, f.verdict, i.subject FROM findings f JOIN investigations i ON i.id = f.investigation_id WHERE (NULLIF('${investigation_id}', '') IS NULL OR f.investigation_id::text = NULLIF('${investigation_id}', '')) ORDER BY f.ts DESC LIMIT 25",
          "refId": "A"
        }
      ],
      "title": "Recent findings",
      "type": "table"
    },
    {
      "datasource": {
