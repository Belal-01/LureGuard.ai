<!-- LureGuard custom Wazuh rules -->
<group name="lureguard_custom,">

  <!-- Cowrie session events (rule IDs >= 100000) -->
  <rule id="100001" level="8">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.login.failed</field>
    <description>Cowrie: Failed login attempt on honeypot</description>
    <group>cowrie,authentication_failed,lureguard_custom</group>
  </rule>

  <rule id="100002" level="10">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.login.success</field>
    <description>Cowrie: Successful login to honeypot</description>
    <group>cowrie,authentication_success,lureguard_custom</group>
  </rule>

  <rule id="100003" level="12">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.command.input</field>
    <description>Cowrie: Command executed in honeypot</description>
    <group>cowrie,lureguard_custom</group>
  </rule>

  <!-- Web attack heuristics (apache/nginx access logs) -->
  <rule id="100010" level="10">
    <if_sid>31100,31101,31102,31103,31104,31105,31106,31107,31108,31109,31110,31115,31120,31121,31122,31123,31140,31141,31151,31152,31153,31154,31161,31162,31163,31164,31165,31166,31167,31168,31169,31170,31171,31200</if_sid>
    <match>union select|select.*from|or 1=1|' or '|";--|/etc/passwd|\.\./\.\./</match>
    <description>LureGuard: SQLi or path traversal probe in web request</description>
    <group>web,web-attack,sql_injection,lureguard_custom</group>
  </rule>

  <rule id="100011" level="8">
    <if_sid>31100,31101,31102,31103,31104,31105,31106,31107,31108,31109,31110,31115,31120,31121,31122,31123,31140,31141,31151,31152,31153,31154,31161,31162,31163,31164,31165,31166,31167,31168,31169,31170,31171,31200</if_sid>
    <match>&lt;script|javascript:|onerror=|onload=|alert\(</match>
    <description>LureGuard: XSS probe in web request</description>
    <group>web,web-attack,xss,lureguard_custom</group>
  </rule>

  <rule id="100012" level="7">
    <if_sid>31100,31101,31102,31103,31104,31105,31106,31107,31108,31109,31110,31115,31120,31121,31122,31123,31140,31141,31151,31152,31153,31154,31161,31162,31163,31164,31165,31166,31167,31168,31169,31170,31171,31200</if_sid>
    <match>sqlmap|nikto|acunetix|dirbuster|gobuster|wpscan</match>
    <description>LureGuard: Web scanner user-agent or tool signature</description>
    <group>web,scanner,web-attack,lureguard_custom</group>
  </rule>

  <!-- ── Post-compromise detection (ML-5) ─────────────────────────────
       Everything above fires before or at the door. These fire after it.

       Each rule below sits on a channel this deployment actually collects,
       and nowhere else:
         * syscheck watches /etc and /root/.ssh in realtime and /usr/bin,
           /usr/sbin, /bin, /sbin, /boot on a schedule (wazuh/agent-ossec.conf) —
           so file-borne persistence in those paths is visible, and persistence
           elsewhere (/var/spool/cron, a user's ~/.profile) is NOT. The path
           patterns are deliberately kept inside what is monitored.
         * cowrie.command.input carries the attacker's own shell input, which is
           the only post-login command telemetry this product has. There is no
           auditd/execve feed, so the same commands typed on a real host are
           invisible — these rules claim the honeypot, not the fleet.
         * sudo lines come from /var/log/auth.log, already collected for sshd.
       Nothing here needs Windows, EDR or netflow data we do not receive.

       Every rule carries lureguard_custom, which is in _FORWARD_GROUPS
       (wazuh/integrations/custom-lureguard.py) — a rule that never reaches
       core is a detection that silently never fires. -->

  <!-- Persistence — T1098.004: an attacker's key survives a password reset. -->
  <rule id="100020" level="12">
    <if_sid>550,554</if_sid>
    <field name="file">authorized_keys$</field>
    <description>LureGuard: SSH authorized_keys changed — key persistence</description>
    <group>syscheck,lureguard_custom</group>
  </rule>

  <!-- Persistence — T1053.003: /etc/cron* only; /var/spool/cron is not monitored. -->
  <rule id="100021" level="12">
    <if_sid>550,554</if_sid>
    <field name="file">^/etc/cron</field>
    <description>LureGuard: cron entry added or changed — scheduled task persistence</description>
    <group>syscheck,lureguard_custom</group>
  </rule>

  <!-- Persistence — T1543.002: a unit file is the modern rc.local. -->
  <rule id="100022" level="12">
    <if_sid>550,554</if_sid>
    <field name="file">^/etc/systemd/system/</field>
    <description>LureGuard: systemd unit added or changed — service persistence</description>
    <group>syscheck,lureguard_custom</group>
  </rule>

  <!-- Privilege escalation — T1548.003: sudoers edited outside a package upgrade. -->
  <rule id="100023" level="12">
    <if_sid>550,554</if_sid>
    <field name="file">^/etc/sudoers</field>
    <description>LureGuard: sudoers changed — privilege grant</description>
    <group>syscheck,lureguard_custom</group>
  </rule>

  <!-- Privilege escalation — T1548.003 via GTFOBins-style shell escape.
       Parent 5402 is "successful sudo to ROOT" (level 3, fires on every
       legitimate sudo too); the COMMAND match is what makes this worth an
       alert, so the base rule stays out of _FORWARD_GROUPS. -->
  <rule id="100024" level="10">
    <if_sid>5402,5403</if_sid>
    <match>COMMAND=/bin/sh|COMMAND=/bin/bash|COMMAND=/bin/dash|COMMAND=/usr/bin/vi|COMMAND=/usr/bin/vim|COMMAND=/usr/bin/less|COMMAND=/usr/bin/find|COMMAND=/usr/bin/awk|COMMAND=/usr/bin/perl|COMMAND=/usr/bin/python</match>
    <description>LureGuard: sudo shell escape to root</description>
    <group>sudo,lureguard_custom</group>
  </rule>

  <!-- Discovery — T1082/T1033: first thing a human does on a new box. -->
  <rule id="100030" level="12">
    <if_sid>100003</if_sid>
    <field name="input">whoami|^id$|uname|/etc/passwd|/etc/shadow|ps aux|netstat|ss -|lscpu|lsb_release|hostname</field>
    <description>LureGuard: host and account discovery commands in honeypot session</description>
    <group>cowrie,lureguard_custom</group>
  </rule>

  <!-- Command and control — T1105: stage two arrives over HTTP. -->
  <rule id="100031" level="13">
    <if_sid>100003</if_sid>
    <field name="input">wget|curl|tftp|nc -|ftpget</field>
    <description>LureGuard: payload download in honeypot session</description>
    <group>cowrie,lureguard_custom</group>
  </rule>

  <!-- Defense evasion — T1070.003: covering tracks is itself the signal. -->
  <rule id="100032" level="12">
    <if_sid>100003</if_sid>
    <field name="input">history -c|unset HISTFILE|HISTFILE=/dev/null|.bash_history|shred |/var/log</field>
    <description>LureGuard: history or log tampering in honeypot session</description>
    <group>cowrie,lureguard_custom</group>
  </rule>

</group>
